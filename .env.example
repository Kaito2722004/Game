# Copy to .env and edit. Never commit the real .env.

# --- Database -----------------------------------------------------------
# PostgreSQL is the deployment target. The driver is psycopg 3.
DATABASE_URL=postgresql+psycopg://pd_user:pd_password@localhost:5432/prisoners_dilemma
DATABASE_ECHO=false

# --- Security -----------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-real-random-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---------------------------------------------------------------
# Comma-separated. 5173 is the Vite dev server the React frontend will use.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Application --------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- First admin, created by `python -m app.database.seed` --------------
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-this-admin-password
